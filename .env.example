# ==========================================
# EDUCA FORA DA CAIXA - BACK-END ENVIRONMENT VARIABLES
# ==========================================

# 1. Banco de Dados (Supabase PostgreSQL)
# DATABASE_URL: String de conexão via Transaction Pooler / PgBouncer (Porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: String de conexão direta (Porta 5432) usada pelo Prisma para executar migrações DDL
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# 2. Autenticação e Segurança (JWT)
# Chaves seguras geradas para assinatura de tokens (ex.: openssl rand -base64 32)
JWT_SECRET="educa_super_secret_jwt_access_token_key_2026_change_in_production"
JWT_REFRESH_SECRET="educa_super_secret_jwt_refresh_token_key_2026_change_in_production"

# 3. URLs da Aplicação e CORS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,https://educa-nota-fiscal.vercel.app"

# 4. Supabase Client & Storage (Opcional - Fotos e PDFs)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
